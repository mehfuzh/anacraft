# Copy to .env and fill in. Everything here is baked into the binary at build
# time by build.rs; CI takes the same names from repository secrets instead.

# Google OAuth desktop client (craft login)
ANACRAFT_OAUTH_CLIENT_ID=
ANACRAFT_OAUTH_CLIENT_SECRET=

# Supabase project holding the subscription record (craft subscribe)
ANACRAFT_SUPABASE_URL=https://<project-ref>.supabase.co
ANACRAFT_SUPABASE_KEY=sb_publishable_...
